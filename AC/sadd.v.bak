module sadd(
  input clk,rst_b,
  input x,y,
  output reg o
  );
  
  localparam S0_ST=2'd0;
  localparam S1_ST=2'd1;
  reg [1:0]st;
  reg [1:0]st_next;
  
  always @(*)
    case(st)
      S0_ST: if(x&y)
                st_next=S1_ST;
             else if((~x)&(~y))
                st_next=S0_ST;
             else if((~x)&y)
                st_next=S0_ST;
             else if(x&(~y))
                st_next=S0_ST;
      S1_ST: if((~x)&(~y))
                st_next=S0_ST;
           else if((~x)&y)
             st_next=S1_ST;
           else if(x&(~y))
             st_next=S1_ST;
           else if(x&y)
             st_next=S1_ST;
     endcase
  
 always @(*)begin
  o=0; // Default
  case(st)
    S0_ST: if((~x & y) || (x & ~y)) o=1;
    S1_ST: if( (x & y) || (~x & ~y)) o=1;
  endcase
end
  always @(posedge clk,negedge rst_b) begin
    if(!rst_b)  st<=S0_ST;
    else st<=st_next;
  end
endmodule   

module sadd_tb;   
  reg clk,rst_b,x,y;
  wire o;
  
  sadd inst(.clk(clk),.rst_b(rst_b),.x(x),.y(y),.o(o));
  
  initial begin
    clk=0;
    repeat (4) #100 clk=~clk;
  end
  initial begin
    rst_b=0;
    #25 rst_b=~rst_b;
  end
  initial begin
    x=0;
    #100 x=1;
    #200 x=0;
  end
  initial begin
    y=1;
    #200 y=0;
  end
endmodule
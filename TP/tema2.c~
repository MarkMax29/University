void citire(float *v,int *size)
{
  float value;
  for(int i=0;i<*size;i++)
    {
      scanf("%f",&value);
      *(v+i)=value;
    }
}
void afisare(float *v,int size)
{
  float value;
  for(int i=0;i<size;i++)
    {
      value=*(v+i);
      printf("%.1f ",value);
    }
}

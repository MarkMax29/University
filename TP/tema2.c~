int negativ(int el)
{
  return el<0;
}
void stergere(int *v,int *size,int(*conditie)(int))
{
  for(int i=0;i<*size;i++)
    {
      if(conditie(v[i])==1)
	{
	  for(int j=i+1;j<*size;j++)
	    {
	      v[j-1]=v[j];
	    }
	  *size=*size-1;
	  
	}
    }
}

// Funcție pentru tabelare
void tabelare(double a, double b, int n, double (*f)(double)) {
    double step = (b - a) / n; // Calculează lungimea fiecărui segment
    double x = a;
    for (int i = 0; i <= n; ++i) {
        printf("f(%.2f)=%.2f\n", x, f(x));
        x += step; // Avansăm la următorul punct din interval
    }
}


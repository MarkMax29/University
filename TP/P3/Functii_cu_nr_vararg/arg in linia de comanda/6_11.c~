/*Aplicația 6.11: Un program primește în linia de comandă o expresie formată din numere reale și operatorii {add-
adunare, sub-scădere, mul-înmulțire, div-împărțire}. Programul va calcula valoarea expresiei și va afișa rezultatul.
Expresia se calculează de la stânga la dreapta, fără a ține cont de precedența matematică a operatorilor.
Exemplu: ./calcul 10.5 add 1.5 div 3 va afișa: 4
*/

#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<ctype.h>



int main(int argc,char **argv)
{
  char *sir;
  float nr,rez=argv[1];
  for(int i=3;i<argc;i=i+2)
    {
      nr=atof(argv[i]);
      for(int j=2;j<argc-1;j=j+2)
	{
	  sir=argv[j];
	  switch (sir[0])
	    {
	    case 'a':
	      {
		rez=rez+nr;
		break;
	      }
	    case 's':
	      {
		rez=rez-nr;
		break;
	      }
	    case 'm':
	      {
		rez=rez*nr;
		break;
	      }
	    case 'd':
	      {
		rez=rez/nr;
		break;
	      }

	    }
	}
    }
  printf("%.1f\n",rez);

  return 0;
}

Exemplu: ./procesare -f mAria -r -u abac va afișa: Maria CABA
*/

#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<ctype.h>
void maj(char *sir)
{
  for(int i=0;i<strlen(sir);i++)
    {
      sir[i]=toupper(sir[i]);
    }
}
void prim_maj(char *sir)
{
  sir[0]=toupper(sir[0]);
  for(int i=1;i<strlen(sir);i++)
    {
      sir[i]=tolower(sir[i]);
    }
	
}
void inversare(char *sir)
{
  char *cuv;
  for(int j=0,i=strlen(sir)-1;i>=0;i--,j++)
    {
      cuv[j]=sir[i];
    }
  strcpy(sir,cuv);
  

}

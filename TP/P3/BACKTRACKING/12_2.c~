/*Aplicația 12.2: Se citeste un numar natural n. Afisati permutarile multimii 1,2,3...n in care pana la jumatate
elementele sunt in ordine descrescatoare, iar de la jumatate pana la final in ordine crescatoare.
Exemplu:
n=5
permutarile care respecta conditia sunt:
3 2 1 4 5
4 2 1 3 5
4 3 1 2 5
5 2 1 3 4
5 3 1 2 4
5 4 1 2 3
*/

#include<stdio.h>
#include<stdlib.h>
int valid (int *sol,int poz,int n)
{

  for(int i=0;i<poz;i++)
    {
      if(sol[i]==sol[poz])
	return 0;
      if(poz==n/2)
	{
	  for(int j=0;j<poz;j++)
	    {
	      if(sol[j]<sol[j+1])
		return 0;
	    }
	}
    }
  return 1;
}
int solutie(int poz,int n)
{
  return poz==n-1;
}
void afis(int *sol,int n)
{
  for(int i=0;i<n;i++)
    {
      printf("%d ",sol[i]);
    }
  printf("\n");
}
void back(int *sol,int n,int poz)
{

  for(int i=1;i<=n;i++)
    {
      sol[poz]=i;
      if(valif(sol,poz,n))
	{
	  if(solutie(poz,n))
	    afis(sol,n);
	  else
	    back(sol,n,poz+1);
	}
    }
  	      
}
int main()
{int n;
  scanf("%d",&n);
  int sol[n];
  back(sol,n,0);
  


  return 0;
}

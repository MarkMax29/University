/*Aplicația 8.8: Se citesc numerele m,n,p fiecare mai mici decat 10, apoi se citesc matricile a[m][n] și b[n][p]. Se
  cere să se calculeze matricea „c” care rezultă din înmulțirea matricilor a cu b și să se afișeze.*/

#include<stdio.h>
#include<stdlib.h>


void pb()
{
  int m,n,p;
  printf("m=");scanf("%d",&m);
  printf("n=");scanf("%d",&n);
  printf("p=");scanf("%d",&p);
  if(m>10 || n>10 || p>10)
    exit(-1);

  int a[m][n],b[n][p],c[m][p];
  for(int i=0;i<m;i++)
    for(int j=0;j<n;j++)
      scanf("%d",&a[i][j]);
  for(int i=0;i<n;i++)
    for(int j=0;j<p;j++)
      scanf("%d",&b[i][j]);
  for(int i=0;i<m;i++)
    {
      for(int j=0, k=0;j<n && k<n;j++,k++)
	{
	  for(int l=0;l<p;l++)
	    {
	      c[i][l]=(a[i][j]*b[k][l])+c[i][l];
	    }
	}
    }
  for(int i=0;i<m;i++)
    {
      for(int j=0;j<p;j++)
	{
	  printf("%3d ",c[i][j]);
	}
      printf("\n");
    }

}


int main()
{

  pb();
  

}

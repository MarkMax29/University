/*Aplicația 9.7: Se considera o lista liniara dublu inlantuita ale carei noduri sunt memorare cifre. Sa se scrie o functie
care primeste ca parametru adresa primului nod al listei si verifica daca numarul care se compune din cifrele
memorare in lista in ordine este sau nu palindrom. Functia va returna 1 daca este palindrom si 0 in caz contrar.
*/

#include<stdio.h>
#include<stdlib.h>
typedef struct LIST{
  int elem;
  struct LIST *next;
  struct LIST *prev;
}LIST;
LIST *creare_nod(LIST *prev,LIST *next,int elem)
{
  LIST *aux=NULL;
  aux=(LIST*)malloc(sizeof(LIST));
  if(aux==NULL)
    {
      perror(NULL);
      exit(-1);
    }
  aux->elem=elem;
  aux->next=next;
  aux->prev=prev;
  return aux;
}
LIST *inserare_sfarsit(LIST *lista,int elem)
{
  LIST *p=NULL,*aux=creare_nod(NULL,NULL,elem);
  if(lista==NULL)
    lista=aux;
    else
      {
	p=lista;
	while(p->next!=NULL)
	  p=p->next;
	p->next=aux;
	aux->prev=p;
      }
  return lista;
}

int creare_numar(LIST *lista)
{
  int nr=0,x=1;
  LIST *p=lista;
  while(p!=NULL)
    {
      nr=nr*x+p->elem;
      x=x*10;
      p=p->next;
    }
  return nr;
}
int verif_palindrom(LIST *lista)
{
  
  int copy=0,nr=creare_numar(lista),ogl=0,p=1;
  copy=nr;
  while(copy!=0)
    {
      ogl=ogl*p+copy%10;
      copy=copy/10;
      p=p*10;
    }
  if(nr==ogl)
    return 1;
  else
    return 0;

}
int main()
{
  LIST *lista=NULL;
  lista=inserare_sfarsit(lista,2);
  lista=inserare_sfarsit(lista,4);
  lista=inserare_sfarsit(lista,4);
  lista=inserare_sfarsit(lista,2);
  if(verif_palindrom(lista))
    printf("CIFRELE FORMEAZA UN NR PALINDORM\n");
  else
    printf("NU E PALINDROM\n");
  return 0;
}

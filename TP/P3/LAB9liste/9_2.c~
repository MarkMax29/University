#include<stdio.h>
#include<stdlib.h>
typedef struct LIST{
  int elem;
  struct LIST *next;
}LIST;

LIST *creare_nod(LIST *next,int elem)
{
  LIST *aux=NULL;
  aux=(LIST*)malloc(sizeof(LIST));
  if(aux==NULL)
    {
      perror(NULL);
      exit(-1);
    }
  aux->elem=elem;
  aux->next=next;
  return aux;
}
LIST *inserare_sfarsit(LIST *lista,int elem)
{

  LIST *aux=creare_nod(NULL,elem);
  if(lista==NULL)
    lista=aux;
  else
    {
      LIST *p=lista;
      while(p->next!=NULL)
	p=p->next;
      p->next=aux;
    }
  return lista;
 
}


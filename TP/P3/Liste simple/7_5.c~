    }
}
int egale(LIST *lista1,LIST *lista2)
{
  LIST *p=NULL,*q=NULL;
  p=lista1;
  q=lista2;
  int ok;
  while(p!=NULL)
    {
     ok=1;
      while(q!=NULL)
	{
	  if(p->elem==q->elem)
	    ok=0;
	  q=q->next;
	}
      if(ok==1)
	return 0;
      p=p->next;
    }
  return 1;
  
}
